PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=https://your-production-frontend.example.com

DATABASE_URL=postgresql://postgres:password@localhost:5432/waste_warrior

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=waste_warrior_token

# Storage Configuration
# Default is 'local' (backend/uploads/). For ephemeral production environments, configure an object storage adapter.
STORAGE_PROVIDER=local
